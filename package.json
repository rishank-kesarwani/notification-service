{
  "name": "dual-channel-notification-service",
  "version": "1.0.0",
  "description": "Production-Grade Dual-Channel Notification Engine (Email & Push) with BullMQ, Redis, Resend, FCM, and Nodemailer Fallback",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "start:workers": "node dist/workers/worker-runner.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only src/workers/worker-runner.ts",
    "worker:email:critical": "WORKER_TYPE=email_critical ts-node-dev --respawn --transpile-only src/workers/worker-runner.ts",
    "worker:email:bulk": "WORKER_TYPE=email_bulk ts-node-dev --respawn --transpile-only src/workers/worker-runner.ts",
    "worker:push:critical": "WORKER_TYPE=push_critical ts-node-dev --respawn --transpile-only src/workers/worker-runner.ts",
    "worker:push:bulk": "WORKER_TYPE=push_bulk ts-node-dev --respawn --transpile-only src/workers/worker-runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "notifications",
    "bullmq",
    "redis",
    "email",
    "push",
    "fcm",
    "resend",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
