# Server Config
PORT=3000
NODE_ENV=development
API_KEY=test-api-key-12345
JWT_SECRET=your-super-secret-jwt-key

# Redis Config (BullMQ Engine & Rate Limiter & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=homepage-63db3
FCM_CLIENT_EMAIL=firebase-adminsdk-6h3ax@homepage-63db3.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email Services
# Primary Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Notification Service <onboarding@resend.dev>"

# Fallback Email (Gmail / Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Notification Service <your_email@gmail.com>"
